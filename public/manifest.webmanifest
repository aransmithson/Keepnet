{
  "name": "Keepnet — Fishing Journal & Angler Map",
  "short_name": "Keepnet",
  "description": "Log fishing swims, live atmospheric weather, catches, species weight, and personal bests with private or cloud sync.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#014731",
  "theme_color": "#014731",
  "categories": ["sports", "lifestyle", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "New Session",
      "short_name": "Session",
      "description": "Start a new fishing session",
      "url": "/?action=new-session",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Discover Venues",
      "short_name": "Discover",
      "description": "Explore UK fisheries and venues",
      "url": "/?tab=discover",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
